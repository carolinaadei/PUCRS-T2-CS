// ============================================================
// ViajaJunto - Modelo de dados
// Espelha a Secao 5 do Documento de Arquitetura (DER / DLD).
// Nomes de tabelas e colunas em snake_case (@@map / @map) para
// manter o banco identico ao documentado; o codigo TypeScript
// usa camelCase.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------- Enums ----------------------------

enum StatusViagem {
  EM_PLANEJAMENTO
  CONFIRMADA
  CONCLUIDA

  @@map("status_viagem")
}

enum PermissaoMembro {
  EDITOR
  VISUALIZADOR

  @@map("permissao_membro")
}

enum CategoriaDestino {
  CIDADE
  PRAIA
  NATUREZA
  CULTURAL

  @@map("categoria_destino")
}

enum TipoAtividade {
  PASSEIO
  REFEICAO
  HOSPEDAGEM
  TRANSPORTE
  OUTRO

  @@map("tipo_atividade")
}

enum StatusAtividade {
  PENDENTE
  CONFIRMADA
  CONCLUIDA

  @@map("status_atividade")
}

enum TipoNotificacao {
  VIAGEM_ATUALIZADA
  DESTINO_ADICIONADO
  DESTINO_ATUALIZADO
  DESTINO_REMOVIDO
  ATIVIDADE_ADICIONADA
  ATIVIDADE_ATUALIZADA
  ATIVIDADE_REMOVIDA
  ORCAMENTO_ATUALIZADO
  ORCAMENTO_REMOVIDO
  MEMBRO_ENTROU
  MEMBRO_SAIU
  MEMBRO_REMOVIDO
  PERMISSAO_ALTERADA

  @@map("tipo_notificacao")
}

// ------------------------ Modelos ---------------------------

/// Contas de usuario. A senha e sempre persistida com hash.
model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(180)
  senhaHash    String   @map("senha_hash") @db.VarChar(255)
  /// Vai no JWT (`ver`) e e conferida a cada requisicao pela JwtStrategy.
  /// Incrementar invalida todos os tokens de acesso ja emitidos.
  versaoSessao Int      @default(0) @map("versao_sessao")
  criadoEm     DateTime @default(now()) @map("criado_em")

  viagensCriadas         Viagem[]                @relation("ViagensCriadas")
  membroEm               MembroViagem[]
  avaliacoes             Avaliacao[]
  tokensRecuperacaoSenha TokenRecuperacaoSenha[]
  sessoes                SessaoRefresh[]
  notificacoes           Notificacao[]
  destinosCadastrados    DestinoCatalogo[]
  atividadesCadastradas  CatalogoAtividade[]

  @@map("usuario")
}

/// Sessao de longa duracao: cada login emite um refresh token, guardado aqui
/// apenas como hash. O token e trocado a cada uso (rotacao); reapresentar um
/// token ja trocado indica roubo e derruba todas as sessoes do usuario.
model SessaoRefresh {
  id         Int       @id @default(autoincrement())
  usuarioId  Int       @map("usuario_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiraEm   DateTime  @map("expira_em")
  revogadaEm DateTime? @map("revogada_em")
  criadaEm   DateTime  @default(now()) @map("criada_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, revogadaEm])
  @@map("sessao_refresh")
}

/// Codigo de uso unico para redefinicao de senha via e-mail.
/// Fluxo em duas etapas: o usuario recebe o codigo de 6 digitos, valida-o em
/// /auth/verificar-codigo e recebe um token de troca de vida curta; so ele
/// autoriza /auth/redefinir-senha.
///
/// Nem o codigo nem o token de troca sao persistidos em claro. O codigo usa
/// HMAC (e nao SHA-256 puro): com apenas 10^6 valores possiveis, um digest sem
/// segredo seria revertido por forca bruta em segundos por quem lesse o banco.
model TokenRecuperacaoSenha {
  id            Int       @id @default(autoincrement())
  usuarioId     Int       @map("usuario_id")
  codigoHash    String    @map("codigo_hash") @db.VarChar(64)
  /// Codigos errados acumulam aqui; ao atingir o teto o registro e queimado.
  /// Defesa independente do IP, ao contrario do rate limit do ThrottlerGuard.
  tentativas    Int       @default(0)
  expiraEm      DateTime  @map("expira_em")
  verificadoEm  DateTime? @map("verificado_em")
  /// Emitido apos o codigo conferir. 256 bits de entropia, logo pode ser unico.
  trocaHash     String?   @unique @map("troca_hash") @db.VarChar(64)
  trocaExpiraEm DateTime? @map("troca_expira_em")
  usadoEm       DateTime? @map("usado_em")
  criadoEm      DateTime  @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // Busca quente: o unico codigo pendente de um usuario.
  @@index([usuarioId, usadoEm])
  @@map("token_recuperacao_senha")
}

/// A viagem e a raiz de agregacao do planejamento.
model Viagem {
  id            String       @id @db.VarChar(12)
  /// Codigo que o criador compartilha para convidar colaboradores. Separado do
  /// `id` para poder ser trocado (e o antigo deixar de valer) sem mexer nas URLs.
  codigoConvite String       @unique @map("codigo_convite") @db.VarChar(12)
  nome          String       @db.VarChar(120)
  descricao     String?      @db.Text
  dataInicio    DateTime?    @map("data_inicio") @db.Date
  dataFim       DateTime?    @map("data_fim") @db.Date
  status        StatusViagem @default(EM_PLANEJAMENTO)
  criadoPor     Int          @map("criado_por")
  criadoEm      DateTime     @default(now()) @map("criado_em")

  criador      Usuario         @relation("ViagensCriadas", fields: [criadoPor], references: [id], onDelete: Cascade)
  membros      MembroViagem[]
  destinos     DestinoViagem[]
  orcamento    Orcamento?
  notificacoes Notificacao[]

  @@index([criadoPor])
  @@map("viagem")
}

/// Vinculo entre usuario e viagem com nivel de permissao.
model MembroViagem {
  id        Int             @id @default(autoincrement())
  viagemId  String          @map("viagem_id") @db.VarChar(12)
  usuarioId Int             @map("usuario_id")
  permissao PermissaoMembro
  entrouEm  DateTime        @default(now()) @map("entrou_em")

  viagem  Viagem  @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([viagemId, usuarioId])
  @@index([usuarioId])
  @@map("membro_viagem")
}

/// Catalogo global de destinos (cidades) reaproveitado entre viagens.
model DestinoCatalogo {
  id          Int               @id @default(autoincrement())
  nome        String            @db.VarChar(120)
  pais        String?           @db.VarChar(80)
  categoria   CategoriaDestino?
  descricao   String?           @db.Text
  latitude    Float?
  longitude   Float?
  fotoUrl     String?           @map("foto_url") @db.VarChar(500)
  fonte       String            @default("manual") @db.VarChar(40)
  idExterno   String?           @map("id_externo") @db.VarChar(2048)
  codigoPais  String?           @map("codigo_pais") @db.VarChar(2)
  atribuicoes Json              @default("[]")
  /// Quem cadastrou; so essa pessoa edita ou exclui. Nulo nos registros do seed
  /// e quando a conta de quem cadastrou e excluida.
  criadoPor   Int?              @map("criado_por")
  criadoEm    DateTime          @default(now()) @map("criado_em")

  criador        Usuario?        @relation(fields: [criadoPor], references: [id], onDelete: SetNull)
  destinosViagem DestinoViagem[]

  @@unique([fonte, idExterno])
  @@index([nome])
  @@index([criadoPor])
  @@map("destino_catalogo")
}

/// Destino do catalogo colocado dentro de uma viagem, com ordem de visita.
model DestinoViagem {
  id                Int       @id @default(autoincrement())
  viagemId          String    @map("viagem_id") @db.VarChar(12)
  destinoCatalogoId Int       @map("destino_catalogo_id")
  chegada           DateTime? @db.Date
  saida             DateTime? @db.Date
  descricao         String?   @db.Text
  /// Posicao no roteiro, de 0 a n-1, sem buracos nem repeticao.
  ordem             Int       @default(0)

  viagem          Viagem            @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  destinoCatalogo DestinoCatalogo   @relation(fields: [destinoCatalogoId], references: [id], onDelete: Restrict)
  atividades      AtividadeViagem[]

  @@index([viagemId])
  @@map("destino_viagem")
}

/// Catalogo global de atividades/locais.
model CatalogoAtividade {
  id             Int           @id @default(autoincrement())
  nome           String        @db.VarChar(180)
  descricao      String?       @db.Text
  tipoAtividade  TipoAtividade @map("tipo_atividade")
  local          String?       @db.VarChar(255)
  cidade         String?       @db.VarChar(120)
  pais           String?       @db.VarChar(80)
  latitude       Float?
  longitude      Float?
  idExterno      String?       @map("id_externo") @db.VarChar(2048)
  codigoPais     String?       @map("codigo_pais") @db.VarChar(2)
  atribuicoes    Json          @default("[]")
  fotoUrl        String?       @map("foto_url") @db.VarChar(500)
  /// Origem do registro: manual, seed ou geoapify.
  fonte          String        @default("manual") @db.VarChar(40)
  mediaAvaliacao Float         @default(0) @map("media_avaliacao")
  /// Quem cadastrou; so essa pessoa edita ou exclui.
  criadoPor      Int?          @map("criado_por")
  criadoEm       DateTime      @default(now()) @map("criado_em")

  criador          Usuario?          @relation(fields: [criadoPor], references: [id], onDelete: SetNull)
  atividadesViagem AtividadeViagem[]
  avaliacoes       Avaliacao[]

  @@unique([fonte, idExterno])
  @@index([nome])
  @@index([tipoAtividade])
  @@index([criadoPor])
  @@map("catalogo_atividade")
}

/// Atividade agendada dentro de um destino da viagem.
model AtividadeViagem {
  id                  Int             @id @default(autoincrement())
  destinoViagemId     Int             @map("destino_viagem_id")
  catalogoAtividadeId Int             @map("catalogo_atividade_id")
  dataHorario         DateTime?       @map("data_horario")
  duracaoMin          Int?            @map("duracao_min")
  custoPrevisto       Decimal?        @map("custo_previsto") @db.Decimal(10, 2)
  status              StatusAtividade @default(PENDENTE)

  destinoViagem     DestinoViagem     @relation(fields: [destinoViagemId], references: [id], onDelete: Cascade)
  catalogoAtividade CatalogoAtividade @relation(fields: [catalogoAtividadeId], references: [id], onDelete: Restrict)

  @@index([destinoViagemId])
  @@index([catalogoAtividadeId])
  @@index([dataHorario])
  @@map("atividade_viagem")
}

/// Orcamento da viagem (relacao 1:1).
model Orcamento {
  id                 Int     @id @default(autoincrement())
  viagemId           String  @unique @map("viagem_id") @db.VarChar(12)
  valorTotal         Decimal @map("valor_total") @db.Decimal(10, 2)
  /// Campo derivado: soma de `atividade_viagem.custo_previsto` da viagem,
  /// recalculada na mesma transacao de cada escrita que mexe nos custos.
  previstoAtividades Decimal @default(0) @map("previsto_atividades") @db.Decimal(10, 2)

  viagem Viagem @relation(fields: [viagemId], references: [id], onDelete: Cascade)

  @@map("orcamento")
}

/// Avaliacao de uma atividade por um usuario registrado.
model Avaliacao {
  id                  Int      @id @default(autoincrement())
  usuarioId           Int      @map("usuario_id")
  catalogoAtividadeId Int      @map("catalogo_atividade_id")
  nota                Int
  comentario          String?  @db.Text
  criadoEm            DateTime @default(now()) @map("criado_em")
  atualizadoEm        DateTime @default(now()) @updatedAt @map("atualizado_em")

  usuario           Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  catalogoAtividade CatalogoAtividade @relation(fields: [catalogoAtividadeId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, catalogoAtividadeId])
  @@index([catalogoAtividadeId])
  @@map("avaliacao")
}

/// Aviso in-app de uma alteracao numa viagem, guardado por destinatario.
model Notificacao {
  id        Int             @id @default(autoincrement())
  usuarioId Int             @map("usuario_id")
  viagemId  String          @map("viagem_id") @db.VarChar(12)
  tipo      TipoNotificacao
  mensagem  String          @db.Text
  lidaEm    DateTime?       @map("lida_em")
  criadaEm  DateTime        @default(now()) @map("criada_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  viagem  Viagem  @relation(fields: [viagemId], references: [id], onDelete: Cascade)

  @@index([usuarioId, criadaEm(sort: Desc)])
  @@index([usuarioId, lidaEm])
  @@map("notificacao")
}
