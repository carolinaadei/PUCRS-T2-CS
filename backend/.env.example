# ============================================================
# ViajaJunto - Backend
# Copie este arquivo para `.env` e ajuste os valores.
# ============================================================

# --- Aplicacao ---
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3001

# --- Banco de dados (PostgreSQL) ---
# Deve bater com os valores do docker-compose.yml
POSTGRES_USER=viajajunto
POSTGRES_PASSWORD=viajajunto
POSTGRES_DB=viajajunto
# Porta do host para o container. Troque (ex.: 5433) se ja houver um
# Postgres local ocupando a 5432 - lembre de refletir na DATABASE_URL.
POSTGRES_PORT=5432
# Nome do projeto no Docker Compose; prefixa o volume do banco
# (<nome>_postgres_data). Copias e worktrees do repositorio dividem o mesmo
# banco por padrao. Para isolar uma delas, descomente com outro nome e use
# tambem outra POSTGRES_PORT.
# COMPOSE_PROJECT_NAME=viajajunto-outra-copia
DATABASE_URL="postgresql://viajajunto:viajajunto@localhost:5432/viajajunto?schema=public"

# --- Autenticacao (RNF03) ---
# Obrigatorio em producao. Em dev/teste cai num padrao se ficar vazio.
# Gere um segredo forte: openssl rand -base64 32
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# --- Integracoes externas (Secao 2 do Documento de Arquitetura) ---
# Servico de Locais/Atividades - Google Places API
GOOGLE_PLACES_API_KEY=

# --- Recuperacao de senha (RF03) ---
# Pepper do HMAC do codigo de 6 digitos. Minimo de 32 caracteres.
# Obrigatorio em producao. Em dev/teste pode ficar vazio: a API sobe com um
# padrao e o codigo aparece no log, sem precisar de e-mail.
# Gere o seu: openssl rand -base64 48
RECUPERACAO_CODIGO_SECRET=

# --- Envio de e-mail - Brevo (RF03) ---
# Obrigatorias em producao. Em dev/teste podem ficar vazias: o envio falha,
# e a falha e apenas registrada no log (a resposta da API segue 200).
# Chave em https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Remetente precisa estar validado no painel do Brevo
BREVO_SENDER_EMAIL=nao-responda@seudominio.com
BREVO_SENDER_NOME=ViajaJunto
