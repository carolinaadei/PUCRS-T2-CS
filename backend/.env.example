# ============================================================
# ViajaJunto - Backend rodando FORA do Docker (npm run start:dev)
# Copie este arquivo para `.env` e ajuste os valores.
#
# Com `docker compose up` na raiz voce nao precisa deste arquivo: a API le
# segredos e configuracao da pilha CloudFormation no MiniStack.
# ============================================================

# --- Aplicacao ---
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Endereco publico da API: vai para o "servers" do Swagger (Try it out).
PUBLIC_URL=http://localhost:3000
# Origens do front, separadas por virgula. "*" libera qualquer origem.
CORS_ORIGINS=http://localhost:3001,http://localhost:5173,http://localhost:4200
# Atras de proxy/load balancer: "true", numero de saltos ("1") ou sub-redes.
# TRUST_PROXY=1

# --- Banco de dados (PostgreSQL) ---
# `npm run db:up` sobe o Postgres do docker-compose.yml da raiz, com as
# variaveis POSTGRES_* e COMPOSE_PROJECT_NAME deste arquivo.
POSTGRES_USER=viajajunto
POSTGRES_PASSWORD=viajajunto
POSTGRES_DB=viajajunto
# Troque (ex.: 5433) se ja houver um Postgres local na 5432 - e reflita abaixo.
POSTGRES_PORT=5432
# Nome do projeto no Compose: prefixa containers e volumes. Copias do
# repositorio (worktrees) dividem o banco por padrao; para isolar, use outro
# nome e outra POSTGRES_PORT.
# COMPOSE_PROJECT_NAME=viajajunto-outra-copia
DATABASE_URL="postgresql://viajajunto:viajajunto@localhost:5432/viajajunto?schema=public"

# --- Autenticacao ---
# Obrigatorio em producao (minimo 32 caracteres): openssl rand -base64 48
JWT_SECRET=troque-este-segredo-em-producao
# Vida do access token. O refresh token dura REFRESH_TOKEN_DIAS.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DIAS=30
BCRYPT_SALT_ROUNDS=10

# --- Recuperacao de senha ---
# Pepper do HMAC do codigo de 6 digitos. Obrigatorio em producao (32+ caracteres).
RECUPERACAO_CODIGO_SECRET=

# --- E-mail ---
# log   = o e-mail sai no terminal (padrao em desenvolvimento)
# brevo = API transacional do Brevo (exige BREVO_API_KEY)
# ses   = Amazon SES (ou o SES do MiniStack, com AWS_ENDPOINT_URL)
# Em producao, so brevo ou ses.
MAIL_PROVEDOR=log
EMAIL_REMETENTE=nao-responda@seudominio.com
EMAIL_REMETENTE_NOME=ViajaJunto
# Chave em https://app.brevo.com/settings/keys/api (o remetente precisa estar validado la)
BREVO_API_KEY=

# --- Servicos AWS (opcionais fora do Docker) ---
# Para usar o MiniStack com a API rodando no host: `npm run infra:up` e descomente.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# AWS_ENDPOINT_URL=http://localhost:4566
# S3_BUCKET_MIDIA=viajajunto-local-midia
# S3_ENDPOINT_PUBLICO=http://localhost:4566
# UPLOAD_TAMANHO_MAXIMO_MB=5
# URL da fila. Sem ela o e-mail sai na hora; com ela, vai para a fila e o
# worker (npm run start:worker) entrega.
# SQS_FILA_EMAILS=http://localhost:4566/000000000000/viajajunto-local-emails
# Ou, em vez de definir as variaveis acima, leia tudo da pilha:
# CONFIG_AWS_SEGREDOS=viajajunto/local/jwt,viajajunto/local/recuperacao
# CONFIG_AWS_PARAMETROS=/viajajunto/local/

# --- Testes de integracao (banco dedicado, e truncado a cada suite) ---
# DATABASE_URL_TESTE="postgresql://viajajunto:viajajunto@localhost:5432/viajajunto_test?schema=public"
# MINISTACK_TESTE=http://localhost:4566
